# Cortex evals — environment (copy to evals/.env, which is gitignored).
# Langfuse Cloud: create a project at https://cloud.langfuse.com -> Settings ->
# API Keys, then paste the public + secret keys below.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# US default: https://us.cloud.langfuse.com   EU: https://cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Enables the LLM-as-judge rubrics (Opus judge). Without it, judges are skipped.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the judge model (default claude-opus-4-8)
# CORTEX_JUDGE_MODEL=claude-opus-4-8
